<Window x:Class="CarDealerApp.Views.BuyCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Покупка автомобиля"
        Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#D1EEFC">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A6A8A"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFCD6"/>
            <Setter Property="BorderBrush" Value="#B5D5CA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12"
            BorderBrush="#B5D5CA" BorderThickness="1"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

           
            <Border Grid.Row="0" Background="#B5D5CA"
                    CornerRadius="12,12,0,0" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="Оформление заказа"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1A3A28"/>
                    <TextBlock x:Name="txtCarName" Text=""
                               FontSize="12" Foreground="#3A6A50"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="420">
                <StackPanel Margin="20,16,20,20">

                    
                    <TextBlock Text="СТОИМОСТЬ" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="txtPrice" Text=""
                               FontSize="20" FontWeight="Bold"
                               Foreground="#1A3A28"
                               Margin="0,0,0,14"/>

                   
                    <StackPanel x:Name="passportPanel" Visibility="Collapsed">

                        
                        <Border Background="#FFF3CD" BorderBrush="#FFD700"
                                BorderThickness="1" CornerRadius="7"
                                Padding="10,8" Margin="0,0,0,14">
                            <TextBlock Text="⚠ Для оформления заказа необходимо указать паспортные данные"
                                       FontSize="11" Foreground="#7A5800"
                                       TextWrapping="Wrap"/>
                        </Border>

                       
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="СЕРИЯ ПАСПОРТА" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPassportSeries"
                                         Style="{StaticResource InputBox}"
                                         MaxLength="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="НОМЕР ПАСПОРТА" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPassportNumber"
                                         Style="{StaticResource InputBox}"
                                         MaxLength="6"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Серия — 4 цифры, номер — 6 цифр"
                                   FontSize="10" Foreground="#8A9AB5"
                                   Margin="0,0,0,14"/>

                       
                        <Border Height="1" Background="#E0EAE0" Margin="0,0,0,14"/>
                    </StackPanel>

                    
                    <TextBlock Text="СПОСОБ ОПЛАТЫ" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbPayment"
                              Height="36" FontSize="13"
                              Background="#FFFCD6"
                              BorderBrush="#B5D5CA"
                              BorderThickness="1"
                              Margin="0,0,0,20">
                        <ComboBoxItem Content="Наличные"/>
                        <ComboBoxItem Content="Кредитная карта"/>
                        <ComboBoxItem Content="Кредит"/>
                    </ComboBox>

                   
                    <TextBlock x:Name="txtError" Text=""
                               Foreground="#C0392B" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Margin="0,0,0,8"/>

                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="btnCancel"
                                Content="Отмена"
                                Height="36" FontSize="13" FontWeight="SemiBold"
                                Foreground="#712B13" Background="#F5C4B3"
                                BorderThickness="0" Cursor="Hand"
                                Click="btnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E0A898"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" x:Name="btnConfirm"
                                Content="Подтвердить заказ"
                                Height="36" FontSize="13" FontWeight="SemiBold"
                                Foreground="#1A3A28" Background="#B5D5CA"
                                BorderThickness="0" Cursor="Hand"
                                Click="btnConfirm_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#9DC4B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
