<Window x:Class="CarDealerApp.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        SizeToContent="Height"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#D1EEFC">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A6A8A"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFCD6"/>
            <Setter Property="BorderBrush" Value="#B5D5CA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PassBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFCD6"/>
            <Setter Property="BorderBrush" Value="#B5D5CA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12"
            BorderBrush="#B5D5CA" BorderThickness="1"
            Margin="16">
        <StackPanel>

            <Border Background="#B5D5CA" CornerRadius="12,12,0,0" Padding="20,16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Регистрация"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#1A3A28" HorizontalAlignment="Center"/>
                    <TextBlock Text="Создание аккаунта клиента"
                               FontSize="11" Foreground="#3A6A50"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="24,16,24,20">

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ФАМИЛИЯ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtSurname" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ИМЯ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtName" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="ОТЧЕСТВО" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtMiddleName" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                <TextBlock Text="ТЕЛЕФОН" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtPhone" Style="{StaticResource InputBox}"
                         MaxLength="11" Margin="0,0,0,2"/>
                <TextBlock Text="Формат: 8XXXXXXXXXX (11 цифр, начинается с 8)"
                           FontSize="10" Foreground="#8A9AB5"
                           Margin="0,0,0,10" TextWrapping="Wrap"/>

                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtEmail" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                
                <TextBlock Text="ПАРОЛЬ" Style="{StaticResource FieldLabel}"/>
                <Grid Height="34" Margin="0,0,0,2">
                    <PasswordBox x:Name="txtPassword"
                                 Style="{StaticResource PassBox}"
                                 Padding="10,0,36,0"/>
                    <TextBox x:Name="txtPasswordVisible"
                             Style="{StaticResource InputBox}"
                             Padding="10,0,36,0"
                             Visibility="Collapsed"/>
                    <Button x:Name="btnShowPassword"
                            Width="30" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,3,0"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            Click="btnShowPassword_Click"
                            ToolTip="Показать / скрыть пароль">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="eyeIcon1" Text="👁"
                                   FontSize="15" Foreground="#8A9ABB"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <TextBlock Text="Мин. 6 символов, 1 заглавная, 1 цифра, 1 спецсимвол (!@#$%^)"
                           FontSize="10" Foreground="#8A9AB5"
                           Margin="0,0,0,10" TextWrapping="Wrap"/>

             
                <TextBlock Text="ПОДТВЕРДИТЕ ПАРОЛЬ" Style="{StaticResource FieldLabel}"/>
                <Grid Height="34" Margin="0,0,0,10">
                    <PasswordBox x:Name="txtConfirmPassword"
                                 Style="{StaticResource PassBox}"
                                 Padding="10,0,36,0"/>
                    <TextBox x:Name="txtConfirmPasswordVisible"
                             Style="{StaticResource InputBox}"
                             Padding="10,0,36,0"
                             Visibility="Collapsed"/>
                    <Button x:Name="btnShowConfirmPassword"
                            Width="30" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,3,0"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            Click="btnShowConfirmPassword_Click"
                            ToolTip="Показать / скрыть пароль">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="eyeIcon2" Text="👁"
                                   FontSize="15" Foreground="#8A9ABB"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <TextBlock x:Name="txtError" Text=""
                           Foreground="#C0392B" FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" Visibility="Collapsed"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Отмена"
                            Height="36" FontSize="13" FontWeight="SemiBold"
                            Foreground="#712B13" Background="#F5C4B3"
                            BorderThickness="0" Cursor="Hand" Click="btnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E0A898"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Content="Зарегистрироваться"
                            Height="36" FontSize="12" FontWeight="SemiBold"
                            Foreground="#1A3A28" Background="#B5D5CA"
                            BorderThickness="0" Cursor="Hand"
                            Click="btnRegister_Click" IsDefault="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#9DC4B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </StackPanel>
        </StackPanel>
    </Border>
</Window>
