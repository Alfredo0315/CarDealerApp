<Window x:Class="CarDealerApp.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация нового пользователя"
        Height="520" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#D1EEFC">

    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A6A8A"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFCD6"/>
            <Setter Property="BorderBrush" Value="#B5D5CA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PassBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFCD6"/>
            <Setter Property="BorderBrush" Value="#B5D5CA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <Border Background="White" CornerRadius="12"
            BorderBrush="#B5D5CA" BorderThickness="1"
            Margin="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Синяя шапка -->
            <Border Grid.Row="0" Background="#B5D5CA"
                    CornerRadius="12,12,0,0"
                    Padding="20,18">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Регистрация"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#1A3A28"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Новый пользователь"
                               FontSize="11"
                               Foreground="#C8E8D8"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Тело формы -->
            <StackPanel Grid.Row="1" Margin="28,18,28,20">

                <TextBlock Text="ЛОГИН" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtLogin" Style="{StaticResource InputBox}"/>

                <TextBlock Text="ПАРОЛЬ" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource PassBox}"/>
                <TextBlock Text="Мин. 6 символов, 1 заглавная, 1 цифра, 1 спецсимвол (!@#$%^)"
                           FontSize="10" Foreground="#8A9AB5" Margin="0,3,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="ПОДТВЕРДИТЕ ПАРОЛЬ" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
                <PasswordBox x:Name="txtConfirmPassword" Style="{StaticResource PassBox}"/>

                <!-- Роль фиксирована — только Client при регистрации -->
                <Border Background="#FFFCD6" BorderBrush="#B5D5CA" BorderThickness="1"
                        CornerRadius="6" Padding="10,0" Height="34" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Роль:" FontSize="12" Foreground="#8A9AB5" Margin="0,0,8,0"/>
                        <TextBlock Text="Client" FontSize="13" FontWeight="SemiBold" Foreground="#1A3A28"/>
                        <TextBlock Text="  (при регистрации роль назначается автоматически)"
                                   FontSize="10" Foreground="#AABBCC" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Ошибка -->
                <TextBlock x:Name="txtError"
                           Text=""
                           Foreground="#C0392B"
                           FontSize="11"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>

                <!-- Зарегистрироваться -->
                <Button x:Name="btnRegister"
                        Content="Зарегистрироваться"
                        Height="38"
                        Margin="0,16,0,8"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="#1A3A28"
                        Background="#B5D5CA"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnRegister_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#8FB8A8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Отмена -->
                <Button x:Name="btnCancel"
                        Content="Отмена"
                        Height="38"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="#712B13"
                        Background="#F5C4B3"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E0A898"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
