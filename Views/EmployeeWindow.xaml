<Window x:Class="CarDealerApp.Views.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник"
        Height="520" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#D1EEFC">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A6A8A"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFCD6"/>
            <Setter Property="BorderBrush" Value="#B5D5CA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#FFFCD6"/>
            <Setter Property="BorderBrush" Value="#B5D5CA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12"
            BorderBrush="#B5D5CA" BorderThickness="1"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#B5D5CA"
                    CornerRadius="12,12,0,0" Padding="20,14">
                <TextBlock x:Name="txtTitle" Text="Добавление сотрудника"
                           FontSize="16" FontWeight="Bold" Foreground="#1A3A28"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16,20,20">

                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ФАМИЛИЯ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtSurname" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ИМЯ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtName" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                </Grid>

               
                <TextBlock Text="ОТЧЕСТВО" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtMiddleName" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

               
                <TextBlock Text="ДОЛЖНОСТЬ" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cmbPost" Style="{StaticResource ComboStyle}" Margin="0,0,0,10">
                    <ComboBoxItem Content="Менеджер по продажам"/>
                    <ComboBoxItem Content="Старший менеджер"/>
                    <ComboBoxItem Content="Менеджер по работе с клиентами"/>
                </ComboBox>

                
                <TextBlock Text="РАБОЧИЙ ТЕЛЕФОН" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtBusinessPhone" Style="{StaticResource InputBox}"
                         MaxLength="11" Margin="0,0,0,2"/>
                <TextBlock Text="Формат: 8XXXXXXXXXX (11 цифр, начинается с 8)"
                           FontSize="10" Foreground="#8A9AB5"
                           Margin="0,0,0,10" TextWrapping="Wrap"/>

               
                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtEmail" Style="{StaticResource InputBox}" Margin="0,0,0,20"/>

               
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="btnCancel" Content="Отмена"
                            Height="36" FontSize="13" FontWeight="SemiBold"
                            Foreground="#712B13" Background="#F5C4B3"
                            BorderThickness="0" Cursor="Hand" Click="btnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E0A898"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" x:Name="btnSave" Content="Сохранить"
                            Height="36" FontSize="13" FontWeight="SemiBold"
                            Foreground="#1A3A28" Background="#B5D5CA"
                            BorderThickness="0" Cursor="Hand" Click="btnSave_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#8FB8A8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
