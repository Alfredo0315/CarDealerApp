<Window x:Class="CarDealerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarDealer - Система управления автосалоном"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="1000"
        Background="#D1EEFC">

    <Window.Resources>

        <!-- Кнопка бокового меню -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8FB8A8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#88AABB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки действий -->
        <Style x:Key="BtnAdd" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0A3D2E"/>
            <Setter Property="Background" Value="#B5D5CA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#9DC4B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnEdit" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7A5000"/>
            <Setter Property="Background" Value="#FFEFC4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0D89A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDel" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#712B13"/>
            <Setter Property="Background" Value="#F5C4B3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0A898"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Шапка колонок DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#B5D5CA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#8FB8A8"/>
        </Style>

        <!-- Строка DataGrid -->
        <Style TargetType="DataGridRow">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8E8D8"/>
                    <Setter Property="Foreground" Value="#1A2A50"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D5ECD5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ячейка DataGrid -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Боковая панель -->
        <Border Background="#B5D5CA" Grid.Column="0">
            <DockPanel>
                <Button x:Name="btnLogout"
                        DockPanel.Dock="Bottom"
                        Content="Выход"
                        Margin="12,0,12,16" Height="36"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="#5A1020" Background="#E0A9B0"
                        BorderThickness="0" Cursor="Hand"
                        Click="btnLogout_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#C88090"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel DockPanel.Dock="Top" Margin="12,16,12,0">
                    <TextBlock Text="CarDealer" FontSize="18" FontWeight="Bold"
                               Foreground="#1A3A28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Border Background="#8FB8A8" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="txtUserRole" Text="Роль: Admin" 
                                       Foreground="#1A3A28" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtUserName" Text=""
                                       Foreground="#1A3A28" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="btnCars"      Content="Автомобили"  Foreground="#1A3A28" Style="{StaticResource MenuButtonStyle}" Click="btnCars_Click"/>
                    <Button x:Name="btnClients"   Content="Клиенты"   Foreground="#1A3A28"   Style="{StaticResource MenuButtonStyle}" Click="btnClients_Click"/>
                    <Button x:Name="btnOrders"    Content="Заказы"     Foreground="#1A3A28"  Style="{StaticResource MenuButtonStyle}" Click="btnOrders_Click"/>
                    <Button x:Name="btnEmployees" Content="Сотрудники"  Foreground="#1A3A28" Style="{StaticResource MenuButtonStyle}" Click="btnEmployees_Click"/>
                    <Button x:Name="btnDillers"   Content="Дилеры"    Foreground="#1A3A28"   Style="{StaticResource MenuButtonStyle}" Click="btnDillers_Click"/>
                    <Button x:Name="btnReports"   Content="Excel"   Foreground="#1A3A28"     Style="{StaticResource MenuButtonStyle}" Click="btnReports_Click"/>
                    <Separator Background="#8FB8A8" Margin="0,14"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock x:Name="txtTitle" Text="Автомобили"
                       FontSize="22" FontWeight="Bold" Foreground="#1A2A50"
                       Margin="0,0,0,10" Grid.Row="0"/>

            <!-- Тулбар с поиском -->
            <Border Grid.Row="1" Background="White" CornerRadius="10"
                    BorderBrush="#B5D5CA" BorderThickness="1"
                    Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnAdd" Content="＋  Добавить" Style="{StaticResource BtnAdd}" Click="btnAdd_Click"/>
                        <Button x:Name="btnEdit"   Visibility="Collapsed" Click="btnEdit_Click"   Width="0"/>
                        <Button x:Name="btnDelete" Visibility="Collapsed" Click="btnDelete_Click" Width="0"/>
                    </StackPanel>
                    <Border Grid.Column="1" HorizontalAlignment="Right"
                            Background="#FFFCD6" BorderBrush="#B5D5CA" BorderThickness="1"
                            CornerRadius="7" Padding="10,0" Height="32">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⌕" FontSize="16" Foreground="#8A9AB5"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="txtSearch" Width="200" FontSize="12"
                                     Foreground="#2A3A5A" Background="Transparent"
                                     BorderThickness="0" VerticalContentAlignment="Center"
                                     TextChanged="txtSearch_TextChanged"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Мастер-деталь -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Список карточек -->
                <Border Grid.Column="0" CornerRadius="10"
                        BorderBrush="#B5D5CA" BorderThickness="1"
                        Background="White"
                        ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="dataGrid"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="10"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="dataGrid_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <!-- Карточка детали -->
                <Border Grid.Column="1" x:Name="detailPanel"
                        Width="290"
                        Margin="12,0,0,0"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#B5D5CA" BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Шапка карточки -->
                        <Border Grid.Row="0" Background="#B5D5CA"
                                CornerRadius="10,10,0,0" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="detailTitle"
                                           Text="Детали"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="#1A3A28"
                                           VerticalAlignment="Center"/>
                                <!-- Кнопка закрыть -->
                                <Button Grid.Column="1"
                                        Content="✕"
                                        Width="26" Height="26"
                                        FontSize="13"
                                        Foreground="#1A3A28"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="btnCloseDetail_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Тело карточки — поля записи -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="detailBody" Margin="16,14,16,0"/>
                        </ScrollViewer>

                        <!-- Кнопки карточки -->
                        <Border Grid.Row="2"
                                x:Name="detailButtonsBar"
                                BorderBrush="#E8F0F8" BorderThickness="0,1,0,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="✕  Удалить"
                                        Height="34" FontSize="12" FontWeight="SemiBold"
                                        Foreground="#712B13" Background="#F5C4B3"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="btnDelete_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E0A898"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="2"
                                        Content="Изменить"
                                        Height="34" FontSize="12" FontWeight="SemiBold"
                                        Foreground="#7A5000" Background="#FFEFC4"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="btnEdit_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F0D89A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
